# Gated content (Phase 1) — copy to .env.local for dev, set in Vercel for prod.
# Nothing here is read at module load; `next build` runs fine without these.

# Auth.js — generate: openssl rand -base64 32  (must be >=32 chars)
AUTH_SECRET=
# Canonical public origin (also used to validate same-origin redirects).
AUTH_URL=https://www.hysteresisresearch.com

# Google OAuth client (Auth.js infers these from the AUTH_GOOGLE_ prefix).
# Create at https://console.cloud.google.com/apis/credentials — Authorized
# redirect URI: https://www.hysteresisresearch.com/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
